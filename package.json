{
  "name": "chk-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run build",
    "build": "eleventy",
    "sync:credits": "node scripts/sync-releases.mjs",
    "build:live": "npm run sync:credits && npm run build",
    "start": "eleventy --serve",
    "preview:credits": "SPOTIFY_CREDITS_PREVIEW=1 eleventy --output=.cache/spotify-preview && node --watch scripts/spotify-preview-server.mjs",
    "test:spotify": "node --test scripts/spotify-preview.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chkuhlmann/chk-site.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chkuhlmann/chk-site/issues"
  },
  "homepage": "https://calebkuhlmann.studio",
  "description": "Eleventy source for Caleb Kuhlmann's audio engineering and music production website.",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5"
  }
}
