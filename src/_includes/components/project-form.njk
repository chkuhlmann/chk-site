<form action="https://formspree.io/f/xjgznrlq" method="POST" class="contact-form">
    <input type="hidden" name="inquiry_type" value="Project inquiry">
    <p><label for="inquiry-name">Name</label><input id="inquiry-name" type="text" name="name" autocomplete="name" required></p>
    <p><label for="inquiry-email">Email</label><input id="inquiry-email" type="email" name="email" autocomplete="email" required></p>
    <p><label for="inquiry-service">Type of service</label><select id="inquiry-service" name="service_type" required><option value="" disabled selected>Select a service</option><option value="mixing">Mixing</option><option value="production">Production</option><option value="recording">Recording</option><option value="other">Other</option></select></p>
    <p><label for="inquiry-message">Project details, timeline, and the help you’re looking for</label><textarea id="inquiry-message" name="message" rows="6" required></textarea></p>
    <p><button class="button-link" type="submit">Send Project Inquiry</button></p>
</form>
