    <header>
        <div class="title-container">
            <div class="site-title"><a href="/">Caleb Kuhlmann</a></div>
            <div class="accent subtitle">Audio Engineer & Music Producer</div>
        </div>
        <button class="menu-toggle" type="button" aria-label="Toggle menu" aria-controls="nav-menu" aria-expanded="false" onclick="toggleMenu()">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </button>
        <nav id="nav-menu">
            {% for item in navigation %}
            {% if not isHomepage and item.href[0] == "#" %}{% set itemHref = "/" ~ item.href %}{% else %}{% set itemHref = item.href %}{% endif %}
            <span class="nav-item"><a href="{{ itemHref }}">{{ item.label | safe }}</a></span>
            {% endfor %}
        </nav>
    </header>
