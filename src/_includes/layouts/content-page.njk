<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/assets/js/head.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jacquard+12&family=Jacquard+24&family=Jacquarda+Bastarda+9&display=swap" rel="stylesheet">
    <title>{{ title | default(site.title) }} | {{ site.name }}</title>
    <meta name="description" content="{{ description | default(site.defaultDescription) }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ title | default(site.title) }}">
    <meta property="og:description" content="{{ description | default(site.defaultDescription) }}">
    <meta property="og:type" content="{{ socialType | default('website') }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
    <meta name="twitter:card" content="{% if image %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{{ title | default(site.title) }}">
    <meta name="twitter:description" content="{{ description | default(site.defaultDescription) }}">
    {% if image %}<meta name="twitter:image" content="{{ site.url }}{{ image }}">{% endif %}
    <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>

<a class="skip-link" href="#main-content">Skip to content</a>
<div id="container">
{% include "components/site-header.njk" %}
    <main id="main-content" class="content-page">
{{ content | safe }}
    </main>
</div>
    <script src="/assets/js/navigation.js"></script>
</body>
</html>
