<section class="discography" aria-labelledby="credits-title">
  <h1 id="credits-title" class="section-heading">Selected Discography</h1>
  <div class="release-grid">
    {% for release in releases %}
    <article class="release-card">
      <a class="release-cover" href="{{ release.url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Listen to {{ release.title | escape }} on Spotify">
        <img src="{{ release.image | escape }}" alt="{{ release.title | escape }} cover" width="640" height="640" loading="lazy" decoding="async">
      </a>
      <div class="release-caption">
        <p class="release-artist">{{ release.artists | join(' & ') | escape }}</p>
        <h2>{{ release.title | escape }}</h2>
        <p class="release-date"><time datetime="{{ release.releaseDate | escape }}">{{ release.releaseDate | releaseDate }}</time></p>
        <p class="release-role">{{ release.roles | join(' · ') | escape }}</p>
        <details class="track-credits">
          <summary>Credits · {{ release.tracks.length }} {% if release.tracks.length == 1 %}track{% else %}tracks{% endif %}</summary>
          <ul>{% for track in release.tracks %}<li><strong>{{ track.title | escape }}</strong><span>{{ track.role | escape }}</span></li>{% endfor %}</ul>
        </details>
        <a class="release-spotify" href="{{ release.url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Listen to {{ release.title | escape }} on Spotify">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm5.5 17.3a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.1-10.55-1.14a.75.75 0 0 1-.34-1.46c4.58-1.05 8.51-.61 11.67 1.32a.75.75 0 0 1 .25 1.03zm1.47-3.27a.94.94 0 0 1-1.29.31c-3.22-1.98-8.13-2.56-11.94-1.4a.94.94 0 0 1-.55-1.8c4.36-1.32 9.77-.68 13.47 1.6a.94.94 0 0 1 .31 1.29zm.13-3.4C15.24 8.34 8.87 8.13 5.18 9.25a1.13 1.13 0 0 1-.65-2.16c4.24-1.28 11.28-1.03 15.72 1.6a1.13 1.13 0 0 1-1.15 1.94z"/></svg>
          <span>Listen on Spotify ↗</span>
        </a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
