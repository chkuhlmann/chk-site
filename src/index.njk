  <section class="homepage-section" aria-labelledby="services-title">
    <p class="section-number" aria-hidden="true">02</p>
    <h2 id="services-title" class="section-heading">Services</h2>
    <div class="services-list">
      <article><h3>Production</h3><p>Collaborative song, arrangement, recording, and sonic development from early demos through to finished records.</p></article>
      <article><h3>Mixing</h3><p>Detailed, emotionally driven mixes that preserve the character and intent of the original performance.</p></article>
      <article><h3>Engineering</h3><p>Tracking, editing, studio workflow, system troubleshooting, and practical technical support for artists and small creative spaces.</p></article>
    </div>
    <p class="section-link"><a class="inline-link" href="/contact/#project-inquiry">Ask About a Project <span aria-hidden="true">→</span></a></p>
  </section>

