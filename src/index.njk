{% include "components/site-header.njk" %}

<main id="main-content" class="homepage">
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">Nashville, TN · available locally and remotely</p>
    <h1 id="hero-title">Music production, mixing, and audio engineering with a human point of view.</h1>
    <p class="hero-intro">Caleb Kuhlmann is a Nashville-based producer and audio engineer helping artists realize their sonic dreams.</p>
    <div class="cta-group">
      <a class="button-link" href="#selected-work">Hear Selected Work</a>
      <a class="text-cta" href="/contact/#project-inquiry">Start a Project <span aria-hidden="true">→</span></a>
